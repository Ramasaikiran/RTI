# Resend — https://resend.com/api-keys (free tier: 100 emails/day, 3000/month)
RESEND_API_KEY=re_your_key_here

# Sender address. On Resend's free tier, onboarding@resend.dev works
# without domain verification. Use your own verified domain for production.
FROM_EMAIL=RTI+ <onboarding@resend.dev>

# Signs session tokens — any long random string
JWT_SECRET=change-this-to-a-long-random-string

PORT=8787
